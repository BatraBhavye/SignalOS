# -----------------------------------------------------------------------------
# SignalOS Environment Configuration Template
# Copy this file to .env and adjust values for your deployment.
# -----------------------------------------------------------------------------

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=signalos
POSTGRES_PORT=5432

# Application Database Connection String
# For Docker Compose (using the 'db' service name):
DATABASE_URL=postgresql://postgres:postgres_secure_password@db:5432/signalos

# Server Port Binding (Render / Cloud dynamic PORT convention, default 8000)
PORT=8000

# Security: Session Secret Key (Must be a cryptographically strong random value in production)
SESSION_SECRET=change-this-to-a-secure-random-32-character-secret

# User Management & Signup Policy
MAX_USERS=0
ALLOW_SIGNUPS=true

# Local Ollama / AI Extraction (Optional)
# In Docker, use host.docker.internal to reach Ollama running on the host machine
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Remote AI Bridge Configuration (Optional)
AI_BRIDGE_URL=
AI_BRIDGE_TOKEN=

# Google Calendar OAuth Integration (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

